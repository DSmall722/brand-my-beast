# Copy to .env.local for local development.
# Production secrets live in Vercel project settings.

# Neon / Vercel Postgres connection string
DATABASE_URL=

# Resend (optional on P1; waitlist still stores without mail)
RESEND_API_KEY=
RESEND_FROM="BrandMyBeast <hello@brandmybeast.com>"
WAITLIST_NOTIFY_TO=hello@brandmybeast.com

# Force in-memory waitlist (used by Playwright). Never set in production.
# WAITLIST_MODE=memory

# Force in-memory intent ledger (used by Playwright). Never set in Production.
# Vercel Production (VERCEL_ENV=production) ignores INTENT_MODE=memory and requires DATABASE_URL.
# INTENT_MODE=memory
# INTENT_MODE=postgres  # require DATABASE_URL even in local dev

# --- Auth.js (P2) ---
# AUTH_MODE=test keeps CI/local green without OAuth secrets (default outside prod).
# AUTH_MODE=live on production; then set GitHub OAuth (or AUTH_ENABLE_TEST_LOGIN=1 temporarily).
AUTH_MODE=test
# AUTH_SECRET=          # required for AUTH_MODE=live (openssl rand -base64 32)
# AUTH_URL=https://brandmybeast.com
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
# AUTH_ENABLE_TEST_LOGIN=1
# AUTH_TEST_PASSWORD=test

# Comma-separated operator emails for /operator/approvals (P2 intent thread).
# In AUTH_MODE=test, any @example.com user can approve.
# OPERATOR_EMAILS=hello@brandmybeast.com
